{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/zoho-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hysky.news" }],
      "destination": "/news/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hysky.news" }],
      "destination": "/news/:path*"
    }
  ]
}
